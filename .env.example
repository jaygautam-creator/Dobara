# Razorpay test mode only. Never commit live keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Optional. The repo runs end-to-end without this: LLM outputs are cached in
# artifacts/llm_cache/ and committed.
LLM_PROVIDER=gemini
LLM_API_KEY=

# sqlite:///data/dobara.sqlite3 locally; Postgres URL when deployed
DATABASE_URL=sqlite:///data/dobara.sqlite3
